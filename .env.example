# 用 `lark-cli apps +env-set` 注入到妙搭环境；本地调试用脚手架生成的 .env.local。真实值不要提交。
LARK_APP_ID=
LARK_APP_SECRET=
# 「德信智慧航运主数据」Base 的 app_token
BITABLE_APP_TOKEN=
# T04 航次主表的 table_id
BITABLE_TABLE_ID=
# 全部表的 table_id，键为 T01…T10，例如 {"T01":"tblxxx","T04":"tblyyy"}
BITABLE_TABLE_IDS={}
# 存放 IMIP 靠船计划 Excel 的飞书云空间文件夹 token
DRIVE_FOLDER_TOKEN_BERTH_PLAN=
# 数据来源：未设置/memory = 内存演示数据；real = 应用库 + 飞书多维表格
SSPS_STORE=
# 平台角色 bizID → 业务角色（JSON）。不填用默认：ssps_salesman=业务员、ssps_manager=部门主管、ssps_logistics=物流管理员、ssps_admin=系统管理员
ROLE_MAP=
# 飞书部门名称关键字 → 部门（JSON）。不填用默认：{"大宗":"大宗采购部","商务海运":"商务海运部","仓储物流":"仓储物流部"}
DEPT_MAP=
