# 用 `lark-cli apps +env-set` 注入到妙搭环境；本地调试用脚手架生成的 .env.local。真实值不要提交。
LARK_APP_ID=
LARK_APP_SECRET=
# 「德信智慧航运主数据」Base 的 app_token
BITABLE_APP_TOKEN=
# T04 航次主表的 table_id
BITABLE_TABLE_ID=
# 全部表的 table_id，键为 T01…T10，例如 {"T01":"tblxxx","T04":"tblyyy"}
BITABLE_TABLE_IDS={}
# 存放 IMIP 靠船计划 Excel 的飞书云空间文件夹 token
DRIVE_FOLDER_TOKEN_BERTH_PLAN=
